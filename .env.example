# 复制成 .env 再填自己的值（.env 不会进 git）
# 百度：控制台 → 文字识别 → 应用列表
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
# 百度 AES Key 仅新版加密 SDK 需要，这里不用
# BAIDU_AES_KEY=

# OCR.space：https://ocr.space/ocrapi 的免费 key
OCR_SPACE_KEY=

# PaddleOCR（AI Studio）：https://paddleocr.aistudio-app.com 的访问令牌
# 「自动」引擎会优先用它
PADDLE_TOKEN=
# 可选：PaddleOCR-VL-1.6（准，按版块） / PP-OCRv6（快，逐行带坐标）
PADDLE_MODEL=PaddleOCR-VL-1.6

# EasyOCR：https://easyocr.org 控制台创建的 Access Key（eocr_ 开头）
# 按图片长边像素扣点，只能手动选，不在自动链里
EASYOCR_KEY=
